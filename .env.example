# Copiá este archivo como .env (cp .env.example .env) y cambiá los valores.
# El .env real NO se sube a Git.

# Base de datos local. La contraseña la elige cada uno. Mongo la guarda al crear la base por primera vez:
# si después la cambiás acá, también hay que cambiarla adentro de Mongo.
MONGO_USER=pinz
MONGO_PASSWORD=placeholderelijanlaustedes
MONGO_DB=pinz

# Firma las cookies de sesión. En desarrollo puede quedar vacío; en producción es obligatorio
# (generalo con `openssl rand -base64 32`).
SESION_SECRETO=

# Ingreso con Google (console.cloud.google.com > APIs y servicios > Credenciales > ID de cliente OAuth,
# tipo "Aplicación web"). En "Orígenes autorizados de JavaScript" agregá http://localhost:5173
# (no hace falta ningún URI de redireccionamiento). Si quedan vacías, el botón avisa que no está disponible.
# Después de cambiarlas: docker compose up -d (el front también las lee al arrancar).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mail para los códigos de crear cuenta y de cambiar la contraseña. En cualquier URL, la @ va como %40.
# Con Brevo (lo que usa el proyecto): en app.brevo.com > SMTP y API > SMTP copiá el login y generá una clave
# SMTP; el remitente tiene que estar confirmado en Remitentes (app.brevo.com/senders/list).
#   SMTP_URL=smtp://LOGIN%40smtp-brevo.com:CLAVESMTP@smtp-relay.brevo.com:587
#   MAIL_FROM=Pinz <pinz.tesis@gmail.com>
# Con Gmail: activá la verificación en 2 pasos, creá una "contraseña de aplicación" en
# https://myaccount.google.com/apppasswords y usá (la clave sin espacios):
#   SMTP_URL=smtps://tumail%40gmail.com:clavedeaplicacion@smtp.gmail.com:465
#   MAIL_FROM=Pinz <tumail@gmail.com>
# Si queda vacío, el código se muestra en los logs de la API (docker compose logs -f api).
SMTP_URL=
MAIL_FROM=

# ─────────────────────────────────────────────────────────────────────────────
# REFERENCIA: base de datos y colecciones (solo informativo, no se lee)
# ─────────────────────────────────────────────────────────────────────────────
# Mongo corre en el contenedor pinz-db-1, puerto 27017.
# Base de datos: la que diga MONGO_DB (por defecto "pinz").
# Usuario y contraseña: MONGO_USER / MONGO_PASSWORD (usuario root, authSource=admin).
# Conexión (Compass, mongosh):
#   mongodb://MONGO_USER:MONGO_PASSWORD@localhost:27017/MONGO_DB?authSource=admin
#
# Colección "usuarios": una por cuenta (api/src/modelos/Usuario.ts)
#   email                    único, en minúsculas
#   nombre                   vacío hasta que pasa por /bienvenida
#   pinz                     personaje elegido (chispa, brujula, vuelto, siesta, valija,
#                            postal, nono, trasnoche, morfi, cumbre) o null
#   moneda                   ARS | USD | UYU | CLP | BRL (por defecto ARS)
#   contrasenaHash           contraseña hasheada (scrypt); null si solo entra con Google
#   proveedores.google       id de la cuenta de Google, si entró con Google
#   preferencias             presupuestoPorNoche, ritmo, comida, alergias
#   aeropuertos              lista de códigos
#   createdAt / updatedAt    fechas automáticas
#
# Colección "codigoverificacions": códigos de 6 dígitos enviados por mail
# (api/src/modelos/CodigoVerificacion.ts)
#   email                    a quién se mandó
#   proposito                "registro" (crear cuenta) | "recuperar" (olvidé mi contraseña)
#   codigoHash               el código hasheado (nunca se guarda el número)
#   contrasenaHash           en el registro, la contraseña elegida hasta que se confirme
#   intentos                 errores hasta ahora (máximo 5, después se borra)
#   venceEn                  Mongo lo borra solo a los 10 minutos
#   Hay uno solo por email + propósito: pedir otro reemplaza al anterior.
#
# Sesión: no se guarda en la base. Es la cookie "pinz_sesion" (dura 30 días).
