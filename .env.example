# Copiá este archivo como .env y completá las variables que vayas a usar.
# En Windows: Copy-Item .env.example .env
# No subas el .env real a Git ni compartas sus secretos públicamente.

# Para compartir los mismos viajes entre compañeros, todos configuran la URI
# del mismo cluster de MongoDB Atlas. Dejala vacía para usar el Mongo local de Docker.
MONGODB_URI=

# Solo se usan con el Mongo local de Docker (cuando MONGODB_URI está vacía).
MONGO_USER=px
MONGO_PASSWORD=cambiame
MONGO_DB=px

# Lee los comprobantes con Claude (console.anthropic.com). Vacío: el botón de escanear avisa que no está disponible.
ANTHROPIC_API_KEY=

# Credenciales OAuth de Google. Necesarias para iniciar sesión con Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcional en desarrollo. Sin SMTP, el código de ingreso se muestra en los logs de la API.
SMTP_URL=
MAIL_FROM=

# A dónde llega el aviso de cada consulta de "Escribinos" en la landing. Vacío: al mail de MAIL_FROM.
CONTACTO_EQUIPO=

# En producción es obligatorio; en desarrollo la API tiene un valor local predeterminado.
SESION_SECRETO=