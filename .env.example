# Copiá este archivo como .env (cp .env.example .env) y cambiá los valores.
# El .env real NO se sube a Git.

MONGO_USER=px
MONGO_PASSWORD=cambiame
MONGO_DB=px

# Firma las cookies de sesión. En producción es obligatorio: generalo con `openssl rand -base64 32`.
SESION_SECRETO=

# Ingreso con Google (console.cloud.google.com > APIs y servicios > Credenciales > ID de cliente OAuth,
# tipo "Aplicación web"). En "Orígenes autorizados de JavaScript" agregá http://localhost:5173
# (no hace falta ningún URI de redireccionamiento). Si quedan vacías, el botón avisa que no está disponible.
# Después de cambiarlas: docker compose up -d (el front también las lee al arrancar).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mail para el código de registro. Con Gmail: activá la verificación en 2 pasos, creá una "contraseña de
# aplicación" en https://myaccount.google.com/apppasswords y usá (la @ del mail va como %40, la clave sin espacios):
#   SMTP_URL=smtps://tumail%40gmail.com:clavedeaplicacion@smtp.gmail.com:465
#   MAIL_FROM=Pinz <tumail@gmail.com>
# Si queda vacío, el código se muestra en los logs de la API (docker compose logs -f api).
SMTP_URL=
MAIL_FROM=
