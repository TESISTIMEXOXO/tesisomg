# Copiá este archivo como .env (cp .env.example .env) y cambiá los valores.
# El .env real NO se sube a Git.

MONGO_USER=px 
MONGO_PASSWORD=cambiame 
MONGO_DB=px

# A dónde llega el aviso de cada consulta de "Escribinos" en la landing. Vacío: al mail de MAIL_FROM.
CONTACTO_EQUIPO=

# Opcional: otra base Mongo (p. ej. Atlas). Vacío: se usa el Mongo local de Docker con los datos de arriba.
# MONGODB_URI=mongodb+srv://usuario:clave@cluster0.xxxxx.mongodb.net/pinz
